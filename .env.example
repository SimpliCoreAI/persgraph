# Second Brain - Environment Config
# Copy this to .env and fill in your values

# Windows machine (via Tailscale)
WINDOWS_IP=100.x.x.x

# Ollama
OLLAMA_BASE_URL=http://${WINDOWS_IP}:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:72b

# ChromaDB
CHROMA_HOST=${WINDOWS_IP}
CHROMA_PORT=8000

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
