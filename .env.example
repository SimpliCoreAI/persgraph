# PersGraph - Environment Config
# Copy this to .env and fill in your values

# Windows machine (via Tailscale)
WINDOWS_IP=100.x.x.x

# Ollama
OLLAMA_BASE_URL=http://${WINDOWS_IP}:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b

# ChromaDB
CHROMA_HOST=${WINDOWS_IP}
CHROMA_PORT=8000

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Email ingestion / Gmail send path
OPENCLAW_EMAIL=you@gmail.com
OPENCLAW_EMAIL_PASSWORD=your-app-password

# Prebrief email readers (read-only; keep real values in .env.local)
GMAIL_IMAP_USERNAME=your-gmail@example.com
GMAIL_IMAP_APP_PASSWORD=your-gmail-app-password
YAHOO_IMAP_USERNAME=your-yahoo@example.com
YAHOO_IMAP_APP_PASSWORD=your-yahoo-app-password

# Google account (for Calendar/Drive via gog)
GOG_ACCOUNT=you@gmail.com

# Trusted email senders (comma-separated)
TRUSTED_SENDERS=you@gmail.com,other@yourdomain.com

# Telegram (for alerts and commands)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Explore Mode — Nearby POI lookup (optional)
# Enables location-aware suggestions for /TripToggle
# Provider priority: Google Maps > OpenStreetMap > Local DB (always available)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
